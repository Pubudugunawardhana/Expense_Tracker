PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendly?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of frontend origins allowed to call the API (first one is used in emails)
CLIENT_URL=http://localhost:5173

# Optional – password reset emails (https://resend.com). Without it, reset links are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Spendly <onboarding@resend.dev>

# Optional – "Sign in with Google" (OAuth client ID of type "Web application")
GOOGLE_CLIENT_ID=

# Optional – AI quick add, receipt scanning and insights (https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5

# Public demo account (reset nightly)
DEMO_ENABLED=true
DEMO_EMAIL=demo@spendly.app
